#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────
# crane-ctl — Crane server management CLI
# ─────────────────────────────────────────────────────────────────────

# ── Find Crane directory ──
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/Cargo.toml" ] && [ -d "$SCRIPT_DIR/crane-core" ]; then
  CRANE_DIR="$SCRIPT_DIR"
else
  CRANE_DIR="${CRANE_HOME:-$HOME/Crane}"
fi

CRANE_BIN="$CRANE_DIR/target/release/crane-oai"
CRANE_LOG="$CRANE_DIR/crane-oai.log"
CRANE_PID_FILE="$CRANE_DIR/crane-oai.pid"
CRANE_CONF="$CRANE_DIR/.crane-ctl.conf"
VERSION="1.0.0"

# ── Colors & Symbols ──
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
WHITE='\033[1;37m'
BOLD='\033[1m'
DIM='\033[2m'
ITALIC='\033[3m'
RESET='\033[0m'
BG_GREEN='\033[42m'
BG_RED='\033[41m'
BG_YELLOW='\033[43m'
BG_BLUE='\033[44m'
BLACK='\033[0;30m'

# Symbols (unicode)
SYM_CHECK="\xe2\x9c\x94"    # check
SYM_CROSS="\xe2\x9c\x98"    # cross
SYM_ARROW="\xe2\x96\xb6"    # play
SYM_STOP="\xe2\x96\xa0"     # stop
SYM_DOT="\xe2\x97\x8f"      # filled circle
SYM_CIRCLE="\xe2\x97\x8b"   # empty circle
SYM_DASH="\xe2\x94\x80"     # horizontal line
SYM_WARN="\xe2\x9a\xa0"     # warning

# ── Pretty printers ──
banner() {
  echo ""
  echo -e "${CYAN}${BOLD}   crane-ctl${RESET} ${DIM}v${VERSION}${RESET}"
  echo -e "   ${DIM}$(printf '%0.s─' {1..40})${RESET}"
  echo ""
}

label() {
  # label "Key" "value"
  printf "  ${DIM}%-14s${RESET} %b\n" "$1" "$2"
}

section() {
  echo ""
  echo -e "  ${WHITE}$1${RESET}"
  echo -e "  ${DIM}$(printf '%0.s─' $(seq 1 ${#1}))${RESET}"
}

tag_ok()   { echo -e "${BG_GREEN}${BLACK} ${SYM_CHECK} $1 ${RESET}"; }
tag_err()  { echo -e "${BG_RED}${WHITE} ${SYM_CROSS} $1 ${RESET}"; }
tag_warn() { echo -e "${BG_YELLOW}${BLACK} ${SYM_WARN} $1 ${RESET}"; }
tag_info() { echo -e "${BG_BLUE}${WHITE} $1 ${RESET}"; }

info()  { echo -e "  ${BLUE}${SYM_DOT}${RESET}  $*"; }
ok()    { echo -e "  ${GREEN}${SYM_CHECK}${RESET}  $*"; }
warn()  { echo -e "  ${YELLOW}${SYM_WARN}${RESET}  $*"; }
err()   { echo -e "  ${RED}${SYM_CROSS}${RESET}  $*"; }

# Progress bar helper
bar() {
  local pct=$1 width=20 label="${2:-}"
  local filled=$((pct * width / 100))
  local empty=$((width - filled))
  local color="$GREEN"
  [ "$pct" -gt 70 ] && color="$YELLOW"
  [ "$pct" -gt 90 ] && color="$RED"
  printf "${color}"
  printf '%0.s█' $(seq 1 $filled) 2>/dev/null || true
  printf "${DIM}"
  printf '%0.s░' $(seq 1 $empty) 2>/dev/null || true
  printf "${RESET} %3d%%" "$pct"
  [ -n "$label" ] && printf " ${DIM}%s${RESET}" "$label"
}

human_bytes() {
  local bytes=$1
  if [ "$bytes" -ge 1073741824 ]; then
    printf "%.1f GB" "$(echo "scale=1; $bytes / 1073741824" | bc 2>/dev/null || echo "?")"
  elif [ "$bytes" -ge 1048576 ]; then
    printf "%d MB" "$((bytes / 1048576))"
  else
    printf "%d KB" "$((bytes / 1024))"
  fi
}

# ── Get PID if running ──
get_pid() {
  if [ -f "$CRANE_PID_FILE" ]; then
    local pid
    pid=$(cat "$CRANE_PID_FILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
  fi
  return 1
}

# ── Save/Load config ──
save_conf() {
  local model_path="$1" model_type="$2" port="$3"
  cat > "$CRANE_CONF" << EOF
MODEL_PATH="$model_path"
MODEL_TYPE="$model_type"
PORT="$port"
EOF
}

load_conf() {
  if [ -f "$CRANE_CONF" ]; then
    # shellcheck disable=SC1090
    source "$CRANE_CONF"
  fi
}

# ── GPU info helpers ──
get_gpu_info() {
  if ! command -v nvidia-smi &>/dev/null; then
    return 1
  fi

  GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 | sed 's/^[[:space:]]*//')
  GPU_MEM_USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
  GPU_MEM_TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
  GPU_UTIL=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
  GPU_TEMP=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ')
  GPU_POWER=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
  GPU_POWER_LIMIT=$(nvidia-smi --query-gpu=power.limit --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
  GPU_DRIVER=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ')
  GPU_CUDA_VER=$(nvidia-smi 2>/dev/null | grep "CUDA Version" | sed 's/.*CUDA Version: //' | sed 's/ .*//')

  return 0
}

get_process_gpu_mem() {
  local pid=$1
  if command -v nvidia-smi &>/dev/null; then
    nvidia-smi --query-compute-apps=pid,used_gpu_memory --format=csv,noheader,nounits 2>/dev/null | \
      awk -F',' -v p="$pid" '$1 ~ p {gsub(/[ ]/, "", $2); print $2}' | head -1
  fi
}

# ═════════════════════════════════════════════════════════════════════
#  Commands
# ═════════════════════════════════════════════════════════════════════

cmd_start() {
  local MODEL_PATH="" MODEL_TYPE="" PORT=8080

  load_conf

  while [ $# -gt 0 ]; do
    case "$1" in
      --model-path)   MODEL_PATH="$2"; shift 2 ;;
      --model-path=*) MODEL_PATH="${1#--model-path=}"; shift ;;
      --model-type)   MODEL_TYPE="$2"; shift 2 ;;
      --model-type=*) MODEL_TYPE="${1#--model-type=}"; shift ;;
      --port)         PORT="$2"; shift 2 ;;
      --port=*)       PORT="${1#--port=}"; shift ;;
      -f|--foreground) FOREGROUND=true; shift ;;
      *) err "Unknown option: $1"; exit 1 ;;
    esac
  done

  banner
  echo -e "  $(tag_info "START")"
  echo ""

  if [ -z "$MODEL_PATH" ]; then
    err "Missing ${BOLD}--model-path${RESET}"
    echo ""
    echo -e "  ${DIM}Usage:${RESET} crane-ctl start --model-path <path> --model-type <type> [--port <port>]"
    if [ -f "$CRANE_CONF" ]; then
      load_conf
      echo ""
      echo -e "  ${DIM}Last used:${RESET} --model-path ${CYAN}$MODEL_PATH${RESET} --model-type ${CYAN}$MODEL_TYPE${RESET} --port ${CYAN}$PORT${RESET}"
    fi
    echo ""
    exit 1
  fi

  if [ -z "$MODEL_TYPE" ]; then
    err "Missing ${BOLD}--model-type${RESET} (qwen3, qwen3_vl, hunyuan, paddleocr_vl, qwen3_tts)"
    exit 1
  fi

  [ ! -f "$CRANE_BIN" ] && { err "Binary not found: ${BOLD}$CRANE_BIN${RESET}"; echo -e "  ${DIM}Run: cd $CRANE_DIR && bash build.sh${RESET}"; echo ""; exit 1; }
  [ ! -d "$MODEL_PATH" ] && { err "Model not found: ${BOLD}$MODEL_PATH${RESET}"; echo ""; exit 1; }

  if pid=$(get_pid); then
    warn "Already running (PID ${BOLD}$pid${RESET})"
    echo -e "  ${DIM}Use 'crane-ctl restart' or 'crane-ctl stop' first${RESET}"
    echo ""
    exit 1
  fi

  save_conf "$MODEL_PATH" "$MODEL_TYPE" "$PORT"

  label "Model" "${CYAN}$MODEL_PATH${RESET}"
  label "Type" "${BOLD}$MODEL_TYPE${RESET}"
  label "Port" "${BOLD}$PORT${RESET}"
  label "Mode" "$([ "${FOREGROUND:-false}" = true ] && echo "foreground" || echo "daemon")"
  echo ""

  # Foreground
  if [ "${FOREGROUND:-false}" = true ]; then
    info "Starting in foreground..."
    echo ""
    exec "$CRANE_BIN" --model-path "$MODEL_PATH" --model-type "$MODEL_TYPE" --port "$PORT"
  fi

  # Daemon
  info "Starting daemon..."

  nohup "$CRANE_BIN" \
    --model-path "$MODEL_PATH" \
    --model-type "$MODEL_TYPE" \
    --port "$PORT" \
    > "$CRANE_LOG" 2>&1 &

  local daemon_pid=$!
  echo "$daemon_pid" > "$CRANE_PID_FILE"

  sleep 3
  if kill -0 "$daemon_pid" 2>/dev/null; then
    ok "Server started ${DIM}(PID $daemon_pid)${RESET}"
    echo ""
    echo -e "  ${DIM}crane-ctl status${RESET}   ${DIM}─${RESET} view status"
    echo -e "  ${DIM}crane-ctl log${RESET}      ${DIM}─${RESET} tail logs"
    echo -e "  ${DIM}crane-ctl stop${RESET}     ${DIM}─${RESET} stop server"
    echo ""
  else
    err "Failed to start"
    echo -e "  ${DIM}crane-ctl log${RESET}  ${DIM}─${RESET} check what happened"
    echo ""
    exit 1
  fi
}

cmd_stop() {
  banner
  echo -e "  $(tag_warn "STOP")"
  echo ""

  if pid=$(get_pid); then
    info "Stopping server (PID ${BOLD}$pid${RESET})..."
    kill "$pid" 2>/dev/null

    local i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
      printf "\r  ${DIM}Waiting... %ds${RESET}" "$((i + 1))"
      sleep 1
      i=$((i + 1))
    done
    echo ""

    if kill -0 "$pid" 2>/dev/null; then
      warn "Forcing SIGKILL..."
      kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$CRANE_PID_FILE"
    ok "Stopped"
  else
    warn "Not running"
  fi
  echo ""
}

cmd_restart() {
  cmd_stop
  sleep 1
  load_conf

  if [ -z "${MODEL_PATH:-}" ]; then
    err "No saved config"
    echo -e "  ${DIM}Use: crane-ctl start --model-path ... --model-type ...${RESET}"
    echo ""
    exit 1
  fi

  cmd_start --model-path "$MODEL_PATH" --model-type "$MODEL_TYPE" --port "${PORT:-8080}"
}

cmd_status() {
  banner

  if pid=$(get_pid); then
    echo -e "  $(tag_ok "RUNNING")"
    echo ""

    # ── Process info ──
    section "Process"
    label "PID" "${BOLD}$pid${RESET}"

    local rss
    rss=$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ')
    if [ -n "$rss" ]; then
      local mem_kb=$((rss))
      local mem_bytes=$((mem_kb * 1024))
      label "RAM" "$(human_bytes $mem_bytes)"
    fi

    local uptime_sec
    uptime_sec=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
    if [ -n "$uptime_sec" ]; then
      local days=$((uptime_sec / 86400))
      local hours=$(( (uptime_sec % 86400) / 3600))
      local mins=$(( (uptime_sec % 3600) / 60))
      local secs=$((uptime_sec % 60))
      local upstr=""
      [ "$days" -gt 0 ] && upstr="${days}d "
      [ "$hours" -gt 0 ] && upstr="${upstr}${hours}h "
      [ "$mins" -gt 0 ] && upstr="${upstr}${mins}m "
      upstr="${upstr}${secs}s"
      label "Uptime" "$upstr"
    fi

    # ── Config ──
    if [ -f "$CRANE_CONF" ]; then
      load_conf
      section "Server"
      label "Model" "${CYAN}${MODEL_PATH:-?}${RESET}"
      label "Type" "${BOLD}${MODEL_TYPE:-?}${RESET}"
      label "Port" "${BOLD}${PORT:-8080}${RESET}"
      label "Endpoint" "http://localhost:${PORT:-8080}"
    fi

    # ── Health check ──
    local port="${PORT:-8080}"
    section "Health"
    local health_code
    local health_body
    health_body=$(curl -s --max-time 3 "http://localhost:$port/health" 2>/dev/null) && health_code="200" || health_code="000"

    if [ "$health_code" = "200" ]; then
      label "API" "${GREEN}${SYM_CHECK} healthy${RESET}"
    else
      label "API" "${RED}${SYM_CROSS} unreachable${RESET}"
    fi

    # ── GPU info ──
    if get_gpu_info 2>/dev/null; then
      section "GPU"
      label "Device" "${BOLD}$GPU_NAME${RESET}"
      label "Driver" "$GPU_DRIVER"
      label "CUDA" "$GPU_CUDA_VER"

      # VRAM bar
      if [ -n "$GPU_MEM_USED" ] && [ -n "$GPU_MEM_TOTAL" ] && [ "$GPU_MEM_TOTAL" -gt 0 ]; then
        local vram_pct=$((GPU_MEM_USED * 100 / GPU_MEM_TOTAL))
        label "VRAM" "$(bar $vram_pct "${GPU_MEM_USED} / ${GPU_MEM_TOTAL} MiB")"
      fi

      # Process-specific GPU mem
      local proc_gpu_mem
      proc_gpu_mem=$(get_process_gpu_mem "$pid")
      if [ -n "$proc_gpu_mem" ]; then
        label "Crane VRAM" "${BOLD}${proc_gpu_mem} MiB${RESET}"
      fi

      # GPU utilization bar
      if [ -n "$GPU_UTIL" ]; then
        label "GPU Util" "$(bar "$GPU_UTIL")"
      fi

      # Temperature
      if [ -n "$GPU_TEMP" ]; then
        local temp_color="$GREEN"
        [ "$GPU_TEMP" -gt 70 ] && temp_color="$YELLOW"
        [ "$GPU_TEMP" -gt 85 ] && temp_color="$RED"
        label "Temp" "${temp_color}${GPU_TEMP}°C${RESET}"
      fi

      # Power
      if [ -n "$GPU_POWER" ] && [ -n "$GPU_POWER_LIMIT" ]; then
        local power_int=${GPU_POWER%.*}
        local limit_int=${GPU_POWER_LIMIT%.*}
        if [ "$limit_int" -gt 0 ] 2>/dev/null; then
          local power_pct=$((power_int * 100 / limit_int))
          label "Power" "$(bar $power_pct "${GPU_POWER}W / ${GPU_POWER_LIMIT}W")"
        fi
      fi
    fi

    # ── Log tail ──
    if [ -f "$CRANE_LOG" ]; then
      section "Recent Logs"
      echo ""
      tail -5 "$CRANE_LOG" 2>/dev/null | while IFS= read -r line; do
        echo -e "  ${DIM}${line}${RESET}"
      done
    fi

  else
    echo -e "  $(tag_err "STOPPED")"
    echo ""

    if [ -f "$CRANE_CONF" ]; then
      load_conf
      section "Last Config"
      label "Model" "${DIM}${MODEL_PATH:-?}${RESET}"
      label "Type" "${DIM}${MODEL_TYPE:-?}${RESET}"
      label "Port" "${DIM}${PORT:-8080}${RESET}"
      echo ""
      echo -e "  ${DIM}Start with:${RESET} crane-ctl start --model-path $MODEL_PATH --model-type $MODEL_TYPE"
    else
      echo -e "  ${DIM}No saved config. Start with:${RESET}"
      echo -e "  crane-ctl start --model-path <path> --model-type <type>"
    fi

    # Show GPU even when stopped
    if get_gpu_info 2>/dev/null; then
      section "GPU"
      label "Device" "${BOLD}$GPU_NAME${RESET}"
      if [ -n "$GPU_MEM_USED" ] && [ -n "$GPU_MEM_TOTAL" ] && [ "$GPU_MEM_TOTAL" -gt 0 ]; then
        local vram_pct=$((GPU_MEM_USED * 100 / GPU_MEM_TOTAL))
        label "VRAM" "$(bar $vram_pct "${GPU_MEM_USED} / ${GPU_MEM_TOTAL} MiB")"
      fi
    fi
  fi
  echo ""
}

cmd_log() {
  local lines="${1:-50}"
  banner

  if [ ! -f "$CRANE_LOG" ]; then
    warn "No log file: ${DIM}$CRANE_LOG${RESET}"
    echo ""
    exit 1
  fi

  if pid=$(get_pid); then
    echo -e "  $(tag_ok "LIVE") ${DIM}PID $pid | Ctrl+C to exit${RESET}"
    echo ""
    echo -e "  ${DIM}$(printf '%0.s─' {1..60})${RESET}"
    echo ""
    tail -f -n "$lines" "$CRANE_LOG" | while IFS= read -r line; do
      # Colorize log lines
      if echo "$line" | grep -qi "error\|panic\|fatal"; then
        echo -e "  ${RED}$line${RESET}"
      elif echo "$line" | grep -qi "warn"; then
        echo -e "  ${YELLOW}$line${RESET}"
      elif echo "$line" | grep -qi "listening\|started\|ready\|loaded"; then
        echo -e "  ${GREEN}$line${RESET}"
      else
        echo -e "  ${DIM}$line${RESET}"
      fi
    done
  else
    echo -e "  $(tag_warn "OFFLINE") ${DIM}Last $lines lines${RESET}"
    echo ""
    echo -e "  ${DIM}$(printf '%0.s─' {1..60})${RESET}"
    echo ""
    tail -n "$lines" "$CRANE_LOG" | while IFS= read -r line; do
      if echo "$line" | grep -qi "error\|panic\|fatal"; then
        echo -e "  ${RED}$line${RESET}"
      elif echo "$line" | grep -qi "warn"; then
        echo -e "  ${YELLOW}$line${RESET}"
      elif echo "$line" | grep -qi "listening\|started\|ready\|loaded"; then
        echo -e "  ${GREEN}$line${RESET}"
      else
        echo -e "  ${DIM}$line${RESET}"
      fi
    done
  fi
}

cmd_health() {
  load_conf
  local port="${PORT:-8080}"
  banner

  if ! pid=$(get_pid); then
    echo -e "  $(tag_err "OFFLINE")"
    echo ""
    exit 1
  fi

  local start_ms
  start_ms=$(date +%s%N 2>/dev/null || echo "0")
  local response
  response=$(curl -s --max-time 5 "http://localhost:$port/health" 2>/dev/null) || {
    echo -e "  $(tag_err "UNREACHABLE")"
    label "Endpoint" "http://localhost:$port/health"
    echo ""
    exit 1
  }
  local end_ms
  end_ms=$(date +%s%N 2>/dev/null || echo "0")

  local latency_ms=0
  if [ "$start_ms" != "0" ] && [ "$end_ms" != "0" ]; then
    latency_ms=$(( (end_ms - start_ms) / 1000000 ))
  fi

  echo -e "  $(tag_ok "HEALTHY")"
  echo ""
  label "Endpoint" "http://localhost:$port/health"
  label "Response" "$response"
  label "Latency" "${latency_ms}ms"
  label "PID" "$pid"
  echo ""
}

cmd_update() {
  local WAS_RUNNING=false
  local BRANCH="${1:-}"

  if get_pid > /dev/null 2>&1; then
    WAS_RUNNING=true
  fi

  banner
  echo -e "  $(tag_info "UPDATE")"
  echo ""

  cd "$CRANE_DIR"

  info "Fetching latest..."
  local BEFORE
  BEFORE=$(git rev-parse HEAD 2>/dev/null)

  git fetch origin 2>/dev/null || git fetch 2>/dev/null || {
    err "Fetch failed. Check your network."
    exit 1
  }

  if [ -n "$BRANCH" ]; then
    info "Switching to branch ${BOLD}$BRANCH${RESET}..."
    git checkout "$BRANCH" 2>/dev/null || {
      err "Failed to checkout: $BRANCH"
      exit 1
    }
  fi

  git pull --ff-only 2>/dev/null || {
    warn "Cannot fast-forward, trying rebase..."
    git pull --rebase 2>/dev/null || {
      err "Pull failed. Resolve manually."
      exit 1
    }
  }

  local AFTER
  AFTER=$(git rev-parse HEAD 2>/dev/null)

  if [ "$BEFORE" = "$AFTER" ]; then
    ok "Already up to date"
    label "Commit" "${DIM}${AFTER:0:8}${RESET}"
    echo ""
    return 0
  fi

  # Show changelog
  section "Changelog"
  git log --oneline "$BEFORE".."$AFTER" 2>/dev/null | head -10 | while IFS= read -r line; do
    echo -e "  ${GREEN}+${RESET} $line"
  done
  echo ""

  label "Before" "${DIM}${BEFORE:0:8}${RESET}"
  label "After" "${GREEN}${AFTER:0:8}${RESET}"

  # Stop if running
  if [ "$WAS_RUNNING" = true ]; then
    echo ""
    info "Stopping server for rebuild..."
    cmd_stop
  fi

  # Rebuild
  echo ""
  info "Rebuilding..."
  if [ -f "$CRANE_DIR/build.sh" ]; then
    bash "$CRANE_DIR/build.sh"
  else
    local FEATURES_FLAG=""
    if [ -f "$CRANE_BIN" ] && ldd "$CRANE_BIN" 2>/dev/null | grep -q "libcuda"; then
      FEATURES_FLAG="--features flash-attn"
    fi
    # shellcheck disable=SC2086
    cargo build --release $FEATURES_FLAG 2>&1
  fi

  echo ""
  ok "Update complete"

  if [ "$WAS_RUNNING" = true ]; then
    echo ""
    info "Restarting server..."
    cmd_restart
  fi
}

