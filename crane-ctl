  echo -e "    crane-ctl restart"
  echo -e "    crane-ctl update"
  echo -e "    crane-ctl stop"
  echo ""
  echo -e "  ${DIM}After first start, restart/update remember your config.${RESET}"
  echo ""
}

# ═════════════════════════════════════════════════════════════════════
#  Main
# ═════════════════════════════════════════════════════════════════════

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  start)          cmd_start "$@" ;;
  stop)           cmd_stop ;;
  restart)        cmd_restart ;;
  update|upgrade) cmd_update "$@" ;;
  status|ps)      cmd_status ;;
  log|logs)       cmd_log "$@" ;;
  health)         cmd_health ;;
  help|-h|--help) cmd_help ;;
  *)
    err "Unknown command: ${BOLD}$COMMAND${RESET}"
    echo ""
    cmd_help
    exit 1
    ;;
esac
